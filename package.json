{
  "name": "nexus",
  "private": true,
  "version": "0.1.0",
  "description": "Nexus — plateforme de coordination des applications Studio Prism (site statique, aucune étape de build). Ces dépendances servent UNIQUEMENT aux tests.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/unit/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-nexus \"node --test tests/rules/*.test.mjs\"",
    "serve": "python3 -m http.server 8000",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-nexus"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.0.0"
  },
  "engines": { "node": ">=20" }
}
